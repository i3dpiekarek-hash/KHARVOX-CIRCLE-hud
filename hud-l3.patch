diff --git a/src/circlevr/src/vkcore/hud_toggle.cpp b/src/circlevr/src/vkcore/hud_toggle.cpp
new file mode 100644
index 0000000..bcfd10b
--- /dev/null
+++ b/src/circlevr/src/vkcore/hud_toggle.cpp
@@ -0,0 +1,78 @@
+#include "vkcore/hud_toggle.hpp"
+
+#include "vkcore/cvar_book.hpp"
+#include "vkcore/game_text.hpp"
+#include "vkcore/log.hpp"
+#include "vkcore/mp_guard.hpp"
+#include "vkcore/taa_locate.hpp"
+
+#include <cstddef>
+#include <mutex>
+#include <string_view>
+#include <vector>
+
+namespace circlevr::vkcore {
+
+namespace {
+
+constexpr const char* kTag = "hud-toggle";
+
+std::mutex g_mutex;
+bool g_located = false;          // the lookup ran (once; a miss is not retried every press)
+std::byte* g_cvar = nullptr;     // g_showHud's cvar object
+std::string_view g_name;         // the spelling the game registered it under
+cvar_book::SetStringFn g_setter = nullptr;
+
+// Under g_mutex. The game's console is case-insensitive; the registration string has one fixed spelling, so
+// both are tried and the one registered exactly once is kept.
+void locate() {
+    g_located = true;
+    GameImage image;
+    if (!locateGameImage(image, kTag)) {
+        CIRCLE_VR_LOG("%s: the game module cannot be read; the HUD stays as the game has it", kTag);
+        return;
+    }
+    g_setter = reinterpret_cast<cvar_book::SetStringFn>(const_cast<std::byte*>(findCvarSetter(image)));
+    const std::vector<std::string_view> names{"g_showHud", "g_showhud"};
+    const std::vector<std::byte*> objects = findCvarObjects(image, names);
+    for (std::size_t i = 0; i < objects.size(); ++i) {
+        if (objects[i]) {
+            g_cvar = objects[i];
+            g_name = names[i];
+            break;
+        }
+    }
+    if (!g_cvar || !g_setter) {
+        CIRCLE_VR_LOG("%s: %s; the HUD toggle does nothing in this build", kTag,
+                !g_setter ? "cvar SetString not found" : "g_showHud not registered exactly once");
+        g_cvar = nullptr;
+        return;
+    }
+    CIRCLE_VR_LOG("%s: %.*s found; L3 with the left stick at rest hides or shows the HUD (now %d)", kTag,
+            static_cast<int>(g_name.size()), g_name.data(), cvarInt(g_cvar));
+}
+
+} // namespace
+
+void toggleHud() {
+    if (!mp_guard::allowsGameTouch()) {
+        return;
+    }
+    std::lock_guard lock(g_mutex);
+    if (!g_located) {
+        locate();
+    }
+    if (!g_cvar || !g_setter) {
+        return;
+    }
+    const int before = cvarInt(g_cvar);
+    const char* next = before != 0 ? "0" : "1";
+    if (cvar_book::write(g_name, g_cvar, g_setter, next)) {
+        CIRCLE_VR_LOG("%s: HUD %s (%.*s %d -> %s, reads %d)", kTag, before != 0 ? "hidden" : "shown",
+                static_cast<int>(g_name.size()), g_name.data(), before, next, cvarInt(g_cvar));
+    } else {
+        CIRCLE_VR_LOG("%s: the write was refused (guard or cvar book); the HUD is unchanged", kTag);
+    }
+}
+
+} // namespace circlevr::vkcore
diff --git a/src/circlevr/src/vkcore/hud_toggle.hpp b/src/circlevr/src/vkcore/hud_toggle.hpp
new file mode 100644
index 0000000..5e9fe1a
--- /dev/null
+++ b/src/circlevr/src/vkcore/hud_toggle.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+// HUD on/off for the player (L3 tap with the left stick at rest, motor/default_input.hpp).
+//
+// The game's own cvar g_showHud hides the whole gameplay HUD (health, stamina, tool uses, prompts) when it
+// is 0. The retail console refuses it, but the layer writes cvars through the engine's setter
+// (idCVar::SetString) as taa_hooks.cpp and climb_hook.cpp do: the cvar object is found by its registration,
+// the write goes through the cvar book, so a multiplayer guard trip gives the game's own value back.
+//
+// Anything missing (cvar not found once, setter not found, guard not armed) leaves the game untouched and is
+// logged once.
+
+namespace circlevr::vkcore {
+
+// Flips g_showHud between 0 and 1. Cheap; call from the input thread when the player asks for it.
+void toggleHud();
+
+} // namespace circlevr::vkcore
