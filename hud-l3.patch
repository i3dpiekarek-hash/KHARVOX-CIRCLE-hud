new file mode 100644
index 0000000..a266348
--- /dev/null
+++ b/src/circlevr/src/vkcore/hud_toggle.cpp
@@ -0,0 +1,22 @@
+#include "vkcore/hud_toggle.hpp"
+
+#include "vkcore/log.hpp"
+
+#include <atomic>
+
+namespace circlevr::vkcore {
+
+namespace {
+std::atomic<unsigned> g_hidden{0};
+} // namespace
+
+void toggleHud() {
+    const bool nowHidden = (g_hidden.fetch_xor(1u, std::memory_order_acq_rel) & 1u) == 0u;
+    CIRCLE_VR_LOG("hud-toggle: HUD %s", nowHidden ? "hidden" : "shown");
+}
+
+bool hudHidden() {
+    return (g_hidden.load(std::memory_order_relaxed) & 1u) != 0u;
+}
+
+} // namespace circlevr::vkcore
diff --git a/src/circlevr/src/vkcore/hud_toggle.hpp b/src/circlevr/src/vkcore/hud_toggle.hpp
new file mode 100644
index 0000000..57aa342
--- /dev/null
+++ b/src/circlevr/src/vkcore/hud_toggle.hpp
@@ -0,0 +1,20 @@
+#pragma once
+
+// HUD on/off for the player (L3 tap with the left stick at rest: motor/default_input.hpp for the VR
+// controller profile, motor/locomotion_runtime.cpp for a physical gamepad).
+//
+// The gameplay HUD is the GUI quad the layer shows in front of the player (presenter_frame.cpp, the head-yaw
+// anchored panel: health, stamina, tool uses, prompts). While the HUD is hidden that one quad is left out of
+// the frame. Nothing is written into the game: no cvar, no memory, so it works on every build and needs no
+// multiplayer-guard approval. Menus, loading screens, cutscenes, the photo and binocular viewfinders and the
+// hand-aim dot are not affected.
+
+namespace circlevr::vkcore {
+
+// Flips the HUD between hidden and shown. Any thread.
+void toggleHud();
+
+// True while the player has hidden the HUD. Lock-free, any thread.
+bool hudHidden();
+
+} // namespace circlevr::vkcore
