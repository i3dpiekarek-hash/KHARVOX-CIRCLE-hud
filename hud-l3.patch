diff --git a/src/motor/pad_hud_toggle.hpp b/src/motor/pad_hud_toggle.hpp
new file mode 100644
index 0000000..82e4d21
--- /dev/null
+++ b/src/motor/pad_hud_toggle.hpp
@@ -0,0 +1,22 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+namespace circle::motor::input {
+// A physical gamepad's L3 click released within 800 ms, with the left stick not pushed (a click often tilts
+// it a little), asks for the HUD toggle once, on release. With the stick pushed, L3 stays sprint: nothing is
+// sent or removed here, the pad reaches the game as it always did.
+class PadHudToggle {
+ bool held{},candidate{};uint64_t at{};
+public:
+ bool update(bool leftClick,bool rightClick,float stickX,float stickY,uint64_t now){
+  const float mag=std::hypot(stickX,stickY);
+  bool fire=false;
+  if(leftClick&&!held){candidate=mag<.5f&&!rightClick;at=now;}
+  if(leftClick&&(mag>.7f||rightClick))candidate=false;
+  if(!leftClick&&held){fire=candidate&&mag<.7f&&now-at<=800;candidate=false;}
+  held=leftClick;
+  return fire;
+ }
+};
+}
